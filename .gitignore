# git-init defaults: common local/generated files
node_modules/
dist/
build/
.next/
out/
.env
.env.*
!.env.example
!.env.*.example
*.log
.cache/
tmp/
temp/
.DS_Store
Thumbs.db

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Generated client evidence, prompts, model traces, screenshots, and delivery files
# Kept locally for resume; may contain business/contact information.
projects/
.website-workflow/businesses/
.workflow.lock

# Credentials/certificates must never enter the reusable source repository
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
